---
import Layout from "../../layouts/Layout.astro";
import pageStyle from "../../styles/pages/calculator-terms.css?raw";
const jsonld = [];
const meta = {
  title: "Dead Hand &mdash; Terms of Service",
  description: "The terms for using Dead Hand: your account, subscriptions and auto-renewal, cancelling, and the limits of what the tool does.",
  robots: "index, follow",
  canonical: "https://getdeadhand.com/calculator-terms/",
